# Copy this file to .env and fill in your own keys. Never commit the real .env.

# Google Gemini API key — used by src/chatbot.py and src/llm_advisor.py
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenWeatherMap API key (free tier) — used by src/weather_service.py
# Get one at https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=

# Optional overrides (defaults are usually fine)
# AGRISENSE_DATA_DIR=D:\Data Science Datasets\agrisense-ai
# AGRISENSE_BATCH_SIZE=32
# AGRISENSE_PHASE1_EPOCHS=10
# AGRISENSE_PHASE2_EPOCHS=20
